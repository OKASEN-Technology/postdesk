# The slide renderer: a small Node service (renderer/README.md). Build the
# TypeScript in one stage, run from the compiled output in another, so the
# image carries no compiler.

FROM node:22-slim AS build
WORKDIR /renderer
COPY renderer/package.json renderer/package-lock.json ./
RUN npm ci
COPY renderer/ ./
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
ENV NODE_ENV=production PORT=3100 HOST=0.0.0.0
WORKDIR /renderer
COPY --from=build /renderer/package.json ./
COPY --from=build /renderer/node_modules ./node_modules
COPY --from=build /renderer/dist ./dist
COPY --from=build /renderer/schema ./schema
COPY --from=build /renderer/themes ./themes
# Your own themes: mount a folder here, or anywhere on RENDERER_THEMES.
RUN mkdir -p /themes && chown node:node /themes
VOLUME ["/themes"]
ENV RENDERER_THEMES=/themes
EXPOSE 3100
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD node -e "fetch('http://127.0.0.1:3100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["node", "dist/cli.js", "serve"]
