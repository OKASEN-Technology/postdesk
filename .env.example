# Copy to .env. Secrets only; everything else is in postdesk.toml.

# Configure the provider for the models selected in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram, the daily interface. From @BotFather: /newbot, copy the token.
# Pair your chat afterwards by sending the bot /start.
TELEGRAM_BOT_TOKEN=

# Instagram, through Meta's API with Facebook Login (docs/instagram-setup.md).
META_APP_ID=
META_APP_SECRET=
# The 60-day user token from the Graph API Explorer. Used once, by
# `postdesk instagram page-token`, which prints the two below.
INSTAGRAM_ACCESS_TOKEN=
# These do not expire. Once set, the user token above is not needed.
INSTAGRAM_PAGE_TOKEN=
INSTAGRAM_USER_ID=

# Database. Docker Compose sets this for you.
DATABASE_URL=postgresql+psycopg://postdesk:postdesk@db:5432/postdesk

# Where the web UI and the media endpoint are reachable from the internet.
# Instagram fetches your slides from here unless you set the S3 block below.
PUBLIC_BASE_URL=http://localhost:8080

# Optional: S3-compatible storage (S3, R2, MinIO) for slide images.
# Set the first four values; the public bucket URL is optional when the app
# is internet-accessible via PUBLIC_BASE_URL.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=

# The slide renderer. Docker Compose sets these for you.
RENDERER_URL=http://renderer:3100
RENDERER_TOKEN=change-me

# The web login. Leave it empty to set the password in the browser on the
# first visit; set it here to fix it. POSTDESK_SECRET_KEY signs the session
# cookie and the Approve / Schedule links in notices; empty means one is generated and
# kept in the database.
POSTDESK_ADMIN_PASSWORD=
POSTDESK_SECRET_KEY=
# Optional: a bearer token for scripts and for `postdesk` on another machine
# (`Authorization: Bearer ...`). Inside Docker the CLI needs none.
POSTDESK_API_TOKEN=

# Where local storage keeps the slide files. Docker Compose sets this to a volume.
POSTDESK_DATA_DIR=var

# Optional one-way notifiers; [notify] in postdesk.toml turns each on (docs/notify.md).
SLACK_WEBHOOK_URL=
# JSON to a URL of yours, signed with POSTDESK_SECRET_KEY when it is set.
NOTIFY_WEBHOOK_URL=
# Email: your SMTP server, or Resend instead (RESEND_API_KEY). SMTP_FROM either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=

# Optional: stable Fernet key for AI keys entered in Settings. Keep this
# outside the database and back it up securely; losing it makes saved keys
# unreadable. Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
POSTDESK_CREDENTIALS_KEY=
